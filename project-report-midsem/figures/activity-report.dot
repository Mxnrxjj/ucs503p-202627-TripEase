// Report layout of docs/diagrams/activity.dot. The actions, guards and lanes
// are the same; the layout is tighter and the text larger so that it stays
// readable on a portrait page. Build: neato -n -Tpdf activity-report.dot -o activity.pdf
digraph G { pad="0.03"; margin=0; splines=line; outputorder=nodesfirst; bgcolor=white; node [fontname="Helvetica", fontsize=17]; edge [arrowsize=0.8, penwidth=1.2];
lane0 [pos="95.0,684.72", label="", shape=box, width=2.6389, height=19.0200, fixedsize=true, style=filled, fillcolor="#f4f4f4", color="#888888", penwidth=1.5];
lh0 [pos="95.0,1336.04", label="Traveller", shape=plaintext, width=0.05, height=0.05, fontsize=17];
lane1 [pos="433.0,684.72", label="", shape=box, width=6.7500, height=19.0200, fixedsize=true, style=filled, fillcolor="#eaf2fb", color="#5b86b5", penwidth=1.5];
lh1 [pos="433.0,1336.04", label="TripEase", shape=plaintext, width=0.05, height=0.05, fontsize=17];
lane2 [pos="733.0,684.72", label="", shape=box, width=1.5833, height=19.0200, fixedsize=true, style=filled, fillcolor="#fdf1e3", color="#c08a4a", penwidth=1.5];
lh2 [pos="733.0,1336.04", label="AI\nprovider", shape=plaintext, width=0.05, height=0.05, fontsize=17];
lane3 [pos="861.0,684.72", label="", shape=box, width=1.9722, height=19.0200, fixedsize=true, style=filled, fillcolor="#eef7ea", color="#6a9b57", penwidth=1.5];
lh3 [pos="861.0,1336.04", label="Places\nprovider", shape=plaintext, width=0.05, height=0.05, fontsize=17];
lane4 [pos="1007.5,684.72", label="", shape=box, width=2.0972, height=19.0200, fixedsize=true, style=filled, fillcolor="#f3ecf8", color="#8a67a8", penwidth=1.5];
lh4 [pos="1007.5,1336.04", label="Cloud\nFirestore", shape=plaintext, width=0.05, height=0.05, fontsize=17];
start [pos="95.0,1283.14", label="", shape=circle, style=filled, fillcolor="#000000", fixedsize=true, width=0.26, height=0.26];
wiz [pos="95.0,1227.24", label="Fill in the wizard,\npress Generate", shape=box, style="rounded,filled", fillcolor="#ffffff", width=0.3, height=0.4];
chk [pos="507,1227.24", label="Validate the trip\ndetails (Zod, dates)", shape=box, style="rounded,filled", fillcolor="#ffffff", width=0.3, height=0.4];
d1 [pos="507,1156.44", label="Valid?", shape=diamond, style=filled, fillcolor="#ffffff", fixedsize=true, width=1.6106, height=0.6772];
err [pos="95.0,1156.44", label="See the error and\nstay on the wizard", shape=box, style="rounded,filled", fillcolor="#ffffff", width=0.3, height=0.4];
stopE [pos="95.0,1075.64", label="", shape=doublecircle, style=filled, fillcolor="#000000", fixedsize=true, width=0.26, height=0.26];
m1 [pos="507,1075.64", label="", shape=diamond, style=filled, fillcolor="#ffffff", fixedsize=true, width=0.4167, height=0.2778];
note [pos="274,1075.64", label="Add a repair\nnote", shape=box, style="rounded,filled", fillcolor="#ffffff", width=0.3, height=0.4];
ask [pos="507,994.6400000000002", label="Ask the AI for\na city split", shape=box, style="rounded,filled", fillcolor="#ffffff", width=0.3, height=0.4];
prop [pos="733.0,994.6400000000002", label="Propose\ncities and\ndays", shape=box, style="rounded,filled", fillcolor="#fdf1e3", width=0.3, height=0.4];
d2 [pos="507,894.2800000000002", label="Plan\nvalid?", shape=diamond, style=filled, fillcolor="#ffffff", fixedsize=true, width=1.6106, height=1.2156];
d3 [pos="274,894.2800000000002", label="Retry\nallowed?", shape=diamond, style=filled, fillcolor="#ffffff", fixedsize=true, width=2.0733, height=1.2156];
fb [pos="274,794.1200000000002", label="Use the fallback\nplanner", shape=box, style="rounded,filled", fillcolor="#ffffff", width=0.3, height=0.4];
m2 [pos="507,794.1200000000002", label="", shape=diamond, style=filled, fillcolor="#ffffff", fixedsize=true, width=0.4167, height=0.2778];
rc [pos="507,723.3200000000003", label="Re-check the plan on the\nserver; replan if it fails", shape=box, style="rounded,filled", fillcolor="#ffffff", width=0.3, height=0.4];
req [pos="507,642.3200000000003", label="Request places\nfor every city", shape=box, style="rounded,filled", fillcolor="#ffffff", width=0.3, height=0.4];
ret [pos="861.0,642.3200000000003", label="Return hotel,\nsights, food\nand nightlife", shape=box, style="rounded,filled", fillcolor="#eef7ea", width=0.3, height=0.4];
