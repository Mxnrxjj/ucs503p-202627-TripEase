m3 [pos="507,441.8000000000003", label="", shape=diamond, style=filled, fillcolor="#ffffff", fixedsize=true, width=0.4167, height=0.2778];
build [pos="507,371.0000000000003", label="Build each day, adding a stop only\nif the day still fits (feasibility)", shape=box, style="rounded,filled", fillcolor="#ffffff", width=0.3, height=0.4];
xfer [pos="507,300.2000000000003", label="Add a transfer on the first\nday of each new city", shape=box, style="rounded,filled", fillcolor="#ffffff", width=0.3, height=0.4];
bud [pos="507,229.40000000000023", label="Work out the budget\n(eight categories)", shape=box, style="rounded,filled", fillcolor="#ffffff", width=0.3, height=0.4];
save [pos="507,168.60000000000022", label="Save the trip", shape=box, style="rounded,filled", fillcolor="#ffffff", width=0.3, height=0.4];
store [pos="1007.5,97.60000000000022", label="Store one\ntrip document\n(owner only)", shape=box, style="rounded,filled", fillcolor="#f3ecf8", width=0.3, height=0.4];
shown [pos="95.0,97.60000000000022", label="Open the new\nroadmap", shape=box, style="rounded,filled", fillcolor="#ffffff", width=0.3, height=0.4];
stop [pos="95.0,31.500000000000227", label="", shape=doublecircle, style=filled, fillcolor="#000000", fixedsize=true, width=0.26, height=0.26];
g1 [pos="537,1108.85", label="[valid]", shape=plaintext, width=0.05, height=0.05, fontsize=16];
g1b [pos="322.01,1167.44", label="[invalid]", shape=plaintext, width=0.05, height=0.05, fontsize=16];
g2 [pos="537,827.3200000000002", label="[valid]", shape=plaintext, width=0.05, height=0.05, fontsize=16];
g2b [pos="398.83,905.2800000000002", label="[not valid]", shape=plaintext, width=0.05, height=0.05, fontsize=16];
g3 [pos="304,992.8400000000001", label="[retry]", shape=plaintext, width=0.05, height=0.05, fontsize=16];
g3b [pos="318,834.5200000000002", label="[no retry]", shape=plaintext, width=0.05, height=0.05, fontsize=16];
g4 [pos="539,475.0000000000003", label="[found]", shape=plaintext, width=0.05, height=0.05, fontsize=16];
g4b [pos="320.5,503.8800000000003", label="[failed or empty]", shape=plaintext, width=0.05, height=0.05, fontsize=16];
start -> wiz;
wiz -> chk;
chk -> d1;
d1 -> err;
err -> stopE;
d1 -> m1;
m1 -> ask;
note -> m1;
ask -> prop;
prop -> d2;
d2 -> d3;
d3 -> note;
d3 -> fb;
d2 -> m2;
fb -> m2;
m2 -> rc;
rc -> req;
req -> ret;
ret -> d4;
d4 -> m3;
d4 -> demo;
demo -> m3;
m3 -> build;
build -> xfer;
xfer -> bud;
bud -> save;
save -> store;
store -> shown;
shown -> stop;
}
