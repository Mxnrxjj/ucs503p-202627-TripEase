graph ER { layout=neato; overlap=false; sep="+6"; splines=true; outputorder=edgesfirst;
bgcolor="white"; fontname="Helvetica"; node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=11];
labelloc=t; fontsize=18; label="TripEase ER Diagram (Chen notation) - overview";
"User" [shape=box, label="User",  fontsize=13, width=1.3, height=0.6, pos="1.0,9.0!", style=filled, fillcolor="#fde7d3"];
"Trip" [shape=box, label="Trip",  fontsize=13, width=1.3, height=0.6, pos="11.0,9.0!", style=filled, fillcolor="#fde7d3"];
"Budget" [shape=box, label="Budget", peripheries=2, fontsize=13, width=1.3, height=0.6, pos="11.0,17.0!", style=filled, fillcolor="#fde7d3"];
"CityPlan" [shape=box, label="City Plan", peripheries=2, fontsize=13, width=1.3, height=0.6, pos="21.0,9.0!", style=filled, fillcolor="#fde7d3"];
"City" [shape=box, label="City",  fontsize=13, width=1.3, height=0.6, pos="7.0,1.0!", style=filled, fillcolor="#fde7d3"];
"Hotel" [shape=box, label="Hotel", peripheries=2, fontsize=13, width=1.3, height=0.6, pos="-1.0,1.0!", style=filled, fillcolor="#fde7d3"];
"TripDay" [shape=box, label="Trip Day",  fontsize=13, width=1.3, height=0.6, pos="15.0,1.0!", style=filled, fillcolor="#fde7d3"];
"Activity" [shape=box, label="Activity",  fontsize=13, width=1.3, height=0.6, pos="23.0,1.0!", style=filled, fillcolor="#fde7d3"];
"r_owns" [shape=diamond, label="owns",  width=1.2, height=0.8, pos="6.0,9.0!", style=filled, fillcolor="#e6f0ff"];
"r_owns" -- "User" [headlabel="1", labeldistance=2.2, labelfontsize=13, labelfontcolor="#b00020", color=black];
"r_owns" -- "Trip" [headlabel="N", labeldistance=2.2, labelfontsize=13, labelfontcolor="#b00020", color="black:white:black", penwidth=1.2];
"r_budget" [shape=diamond, label="has budget", peripheries=2, width=1.2, height=0.8, pos="11.0,13.0!", style=filled, fillcolor="#e6f0ff"];
"r_budget" -- "Trip" [headlabel="1", labeldistance=2.2, labelfontsize=13, labelfontcolor="#b00020", color="black:white:black", penwidth=1.2];
"r_budget" -- "Budget" [headlabel="1", labeldistance=2.2, labelfontsize=13, labelfontcolor="#b00020", color="black:white:black", penwidth=1.2];
"r_plan" [shape=diamond, label="planned by", peripheries=2, width=1.2, height=0.8, pos="16.0,9.0!", style=filled, fillcolor="#e6f0ff"];
"r_plan" -- "Trip" [headlabel="1", labeldistance=2.2, labelfontsize=13, labelfontcolor="#b00020", color=black];
"r_plan" -- "CityPlan" [headlabel="1", labeldistance=2.2, labelfontsize=13, labelfontcolor="#b00020", color="black:white:black", penwidth=1.2];
"r_city" [shape=diamond, label="contains",  width=1.2, height=0.8, pos="9.0,5.0!", style=filled, fillcolor="#e6f0ff"];
"r_city" -- "Trip" [headlabel="1", labeldistance=2.2, labelfontsize=13, labelfontcolor="#b00020", color="black:white:black", penwidth=1.2];
"r_city" -- "City" [headlabel="N", labeldistance=2.2, labelfontsize=13, labelfontcolor="#b00020", color="black:white:black", penwidth=1.2];
"r_day" [shape=diamond, label="has",  width=1.2, height=0.8, pos="13.0,5.0!", style=filled, fillcolor="#e6f0ff"];
"r_day" -- "Trip" [headlabel="1", labeldistance=2.2, labelfontsize=13, labelfontcolor="#b00020", color="black:white:black", penwidth=1.2];
"r_day" -- "TripDay" [headlabel="N", labeldistance=2.2, labelfontsize=13, labelfontcolor="#b00020", color="black:white:black", penwidth=1.2];
"r_hosts" [shape=diamond, label="hosts",  width=1.2, height=0.8, pos="11.0,1.0!", style=filled, fillcolor="#e6f0ff"];
"r_hosts" -- "City" [headlabel="1", labeldistance=2.2, labelfontsize=13, labelfontcolor="#b00020", color="black:white:black", penwidth=1.2];
"r_hosts" -- "TripDay" [headlabel="N", labeldistance=2.2, labelfontsize=13, labelfontcolor="#b00020", color="black:white:black", penwidth=1.2];
"r_stay" [shape=diamond, label="stays at", peripheries=2, width=1.2, height=0.8, pos="3.0,1.0!", style=filled, fillcolor="#e6f0ff"];
"r_stay" -- "City" [headlabel="1", labeldistance=2.2, labelfontsize=13, labelfontcolor="#b00020", color="black:white:black", penwidth=1.2];
"r_stay" -- "Hotel" [headlabel="1", labeldistance=2.2, labelfontsize=13, labelfontcolor="#b00020", color="black:white:black", penwidth=1.2];
"r_incl" [shape=diamond, label="includes",  width=1.2, height=0.8, pos="19.0,1.0!", style=filled, fillcolor="#e6f0ff"];
"r_incl" -- "TripDay" [headlabel="1", labeldistance=2.2, labelfontsize=13, labelfontcolor="#b00020", color=black];
"r_incl" -- "Activity" [headlabel="N", labeldistance=2.2, labelfontsize=13, labelfontcolor="#b00020", color="black:white:black", penwidth=1.2];
}
