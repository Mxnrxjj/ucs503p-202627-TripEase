# Copy this file to `.env.local` and fill in the values from the Firebase console
# (Project settings -> General -> Your apps -> SDK setup and configuration).
# `.env.local` is git-ignored; never commit real keys.

# --- Firebase web app config (safe to expose to the browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Local development ---
# Set to "true" to point the app at the local Firebase Emulator Suite
# (`npm run emulators`) instead of the real project.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# --- Trip generation ---
# The itinerary generator (src/lib/services/itinerary-generator.ts) always
# runs as a deterministic mock planner in V1 — there is no AI provider or
# API key to configure yet. The service is structured so a real provider
# can be dropped in later (see the file's docstring) without changing the
# API route or any UI. No environment variable is required for this; the
# app works fully offline aside from Firebase.

# --- Places data provider ---
# Recommendations (hotels, attractions, restaurants, nightlife), the
# "replace with a real place" search, and place photos all come from
# src/lib/services/places/. Leave both of these unset (or PLACES_PROVIDER
# unset/"mock") to use the built-in, offline mock provider — this is the
# default and requires no external account.
#
# To use live Google Places data instead, set PLACES_PROVIDER=google and
# provide a Places API (New) key below. This key is SERVER-ONLY: do not
# rename it with a NEXT_PUBLIC_ prefix, or it will be bundled into the
# browser and exposed to every visitor. It is only ever read in
# src/lib/services/places/index.ts and the server-side routes that use it
# (app/api/trips/generate, app/api/places/search, app/api/places/photo).
#
# NOTE: the interactive map needs no key at all — it renders OpenStreetMap
# tiles, so the map works in mock mode exactly as it does in Google mode.
PLACES_PROVIDER=mock
GOOGLE_PLACES_API_KEY=
